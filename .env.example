# Copy to .env.local (not committed) and fill in from Supabase:
# Project Settings → API (or "Connect") → Project URL and the publishable / anon key.
# Never put the service-role (secret) key here: everything EXPO_PUBLIC_ ships in the app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-publishable-or-anon-key
